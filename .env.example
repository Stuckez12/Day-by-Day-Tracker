# APP METADATA
APP_VERSION=
APP_PORT=8080
IS_TEST_PROD=false

# DATABASE
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=db
DATABASE_PORT=5432

# PG ADMIN
PGADMIN_EMAIL=email@email.com
PGADMIN_PASSWORD=password

# CELERY
REDIS_URL=redis://redis:6379

# OBJECT STORAGE
S3_HTTP_ADDRESS=http://object-storage:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# MAINTENANCE
EXTERNAL_FILE_PATH=A:/path/to/external/backups

# JWT
JWT_SECRET=secret  # Must be 32 chars in length

# FRONTEND
NEXTAUTH_URL=http://localhost:8080  # Port provided must match APP_PORT
NEXTAUTH_SECRET=12345678901234567890123456789012
API_INTERNAL_URL=http://api:8000
